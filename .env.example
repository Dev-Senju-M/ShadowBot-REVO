# Base de datos (Postgres de Railway). Si se deja vacío se usan los .json locales
# En Railway: variable DATABASE_URL = ${{Postgres.DATABASE_URL}}
DATABASE_URL=

# Discord
TOKEN=
CLIENT_ID=
# Pruebas locales: ID de tu servidor de Discord para registrar los comandos al instante.
# Déjalo vacío en producción para registrarlos de forma global.
GUILD_ID=

# Panel web. Sin DISCORD_CLIENT_SECRET, PANEL_URL y SESSION_SECRET el panel queda desactivado.
# DISCORD_CLIENT_SECRET: Developer Portal → tu app → OAuth2 → Client Secret.
# PANEL_URL: dirección pública del bot (en local http://localhost:3000). Agrega
#   PANEL_URL/auth/callback en OAuth2 → Redirects.
# SESSION_SECRET: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# PANEL_GUILD_ID: servidor que administra el panel (opcional si el bot está en uno solo).
# PANEL_TEMA: opcional, fuerza normal | halloween | navidad.
DISCORD_CLIENT_SECRET=
PANEL_URL=http://localhost:3000
SESSION_SECRET=
PANEL_GUILD_ID=
PANEL_TEMA=

# IA (/ask, personalidad configurable, etc.)
# Crea tu API key en https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Fortnite shop
FNBR_API_KEY=

# Twitch
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_CHANNEL=
TWITCH_NOTIFY_CHANNEL=

# Salud / hosting
HEALTH_PORT=3000
BOT_STATUS=
STATUS_URL=

# Novedades: al arrancar, publica en Discord las versiones nuevas de NOVEDADES.md.
# Actívalo (true) solo en producción (Railway); en local déjalo en false.
ANUNCIAR_NOVEDADES=false

# yt-dlp cookies (opcional, para reproducción de música)
YTDLP_COOKIES_B64=
